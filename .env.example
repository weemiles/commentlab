# Your own key for local loopback UI and CLI. Leave blank on public deployments.
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-preview
# Optional private collector access token; NOT required for the public analysis UI.
COMMENTLAB_ACCESS_TOKEN=
MAX_COMMENTS=3000
YOUTUBE_FETCH_CONCURRENCY=32
YOUTUBE_REQUEST_DELAY_MS=0
YT_DLP_PATH=yt-dlp
JEV_ENV_PATH=
YOUTUBE_COLLECTOR_URL=
YOUTUBE_COLLECTOR_TOKEN=
HOST=127.0.0.1
PORT=4173
