# Optional. When omitted, public comments are collected with the installed yt-dlp.
YOUTUBE_API_KEY=

# Optional override when yt-dlp is not on PATH.
YT_DLP_PATH=yt-dlp

# Speed-first public collector settings. Lower concurrency if YouTube returns 429.
YOUTUBE_FETCH_CONCURRENCY=8
YOUTUBE_REQUEST_DELAY_MS=0

# Jev 감정 분류. 비워두면 ../jev-ultrafast/.env를 자동으로 찾습니다.
JEV_ENV_PATH=
TYPESAFE_API_KEY=

# Optional. Protects a public deployment from unexpectedly large jobs.
MAX_COMMENTS=200000
PORT=4173
HOST=127.0.0.1
